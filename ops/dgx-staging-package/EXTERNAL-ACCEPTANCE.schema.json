{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivecosm.local/schemas/HiveCrewExternalAcceptanceV3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "final_revision", "final_tree", "backend", "web", "authority_overlay_sha256", "compose_sha256", "api", "browser", "data", "degraded", "failure_path", "accepted", "production_unchanged", "run_06_unchanged"],
  "properties": {
    "schema": {"const": "HiveCrewExternalAcceptanceV3"},
    "final_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "backend": {"$ref": "#/$defs/image"},
    "web": {"$ref": "#/$defs/image"},
    "authority_overlay_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_http", "ready_http", "server_version", "verified"],
      "properties": {
        "health_http": {"const": 200},
        "ready_http": {"const": 200},
        "server_version": {"type": "string", "minLength": 1},
        "verified": {"const": true}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "http", "console_errors", "verified"],
      "properties": {
        "url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:"},
        "http": {"const": 200},
        "console_errors": {"type": "integer", "minimum": 0},
        "verified": {"const": true}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_top", "read_only_counts", "verified"],
      "properties": {
        "schema_top": {"type": "integer", "minimum": 1},
        "read_only_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_count", "project_count"],
          "properties": {
            "agent_count": {"type": "integer", "minimum": 0},
            "project_count": {"type": "integer", "minimum": 0}
          }
        },
        "verified": {"const": true}
      }
    },
    "degraded": {"$ref": "#/$defs/failureEvidence"},
    "failure_path": {"$ref": "#/$defs/failureEvidence"},
    "accepted": {"const": false},
    "production_unchanged": {"const": true},
    "run_06_unchanged": {"const": true}
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "id", "digest"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "failureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "evidence"],
      "properties": {
        "verified": {"const": true},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
