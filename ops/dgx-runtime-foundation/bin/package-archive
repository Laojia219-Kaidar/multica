#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repo=$(CDPATH= cd -- "$root/../.." && pwd)
out=${1:-"$repo/../qwen-fast-path-v5.tar"}
list=$(mktemp)
trap 'rm -f "$list"' EXIT
{
  find "$root" -type f -printf 'ops/dgx-runtime-foundation/%P\n'
  printf '%s\n' scripts/security/qwen-landlock-launcher.sh
} | sort -u > "$list"
tar --sort=name --mtime="UTC 1970-01-01" --owner=0 --group=0 --numeric-owner -cf "$out" -C "$repo" -T "$list"
sha=$(sha256sum "$out"|awk '{print $1}')
printf '%s  %s\n' "$sha" "$(basename "$out")" > "$out.sha256"
printf '%s\n' "$out"
