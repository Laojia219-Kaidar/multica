#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
[[ -z "${HIVECREW_QWEN_CHAIN_TRACE:-}" ]] || printf '%s\n' runtime-wrapper >> "$HIVECREW_QWEN_CHAIN_TRACE"
profile=${1:-}; shift || true
[[ "${HIVECREW_CANARY_MODE:-}" == 1 && -n "${HIVECREW_AUTH_TOKEN_REF:-}" && -n "${HIVECREW_WORK_ORDER:-}" ]] || { echo 'fail-closed: explicit canary, auth reference, and WorkOrder required' >&2; exit 77; }
[[ -x /usr/bin/jq ]] || exit 127
row=$(/usr/bin/jq -c --arg id "$profile" '.profiles[]|select(.id==$id)' "$root/profiles.json"); [[ -n "$row" ]] || exit 1
cmd=$(/usr/bin/jq -r .command <<<"$row")
provider=$(/usr/bin/jq -r .provider <<<"$row")
if [[ "$provider" == qwen ]]; then
  [[ "$cmd" == qwen ]] || { echo 'qwen profile command mismatch' >&2; exit 77; }
  [[ "${HIVECREW_QWEN_LANDLOCK_REQUIRED:-}" == 1 ]] || { echo 'qwen landlock required' >&2; exit 77; }
  case "${HIVECREW_QWEN_TOOL_POLICY:-}" in
    deny|bounded_read|bounded_workspace_noshell|bounded_workspace) ;;
    *) echo 'qwen governed tool policy missing' >&2; exit 77 ;;
  esac
  for override in \
    HIVECREW_QWEN_LAUNCHER \
    HIVECREW_QWEN_REAL_HOME \
    HIVECREW_QWEN_SECRET_FILE \
    HIVECREW_LANDLOCK_EXEC \
    HIVECREW_QWEN_BIN; do
    if [[ -n "${!override+x}" ]]; then
      printf '%s\n' 'qwen trust-anchor override rejected' >&2
      exit 77
    fi
  done
  "$root/bin/qwen-preflight"
  launcher="$root/bin/qwen-landlock-launcher.sh"
  [[ -x "$launcher" ]] || launcher="$root/../../scripts/security/qwen-landlock-launcher.sh"
  [[ -x "$launcher" ]] || exit 127
  exec "$launcher" "$@"
fi
path=$(command -v "$cmd" 2>/dev/null || true); [[ -n "$path" ]] || { echo "missing provider CLI: $cmd" >&2; exit 127; }
exec "$path" "$@"
