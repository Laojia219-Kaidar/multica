#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); find "$root" -type f -not -path "*/.installed/*" -not -path "*/.backups/*" -printf "%P\\n" | sort | while read -r f; do printf "%s  %s\\n" "$(sha256sum "$root/$f"|awk "{print \$1}")" "$f"; done | sha256sum | awk "{print \$1}"
