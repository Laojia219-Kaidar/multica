#!/usr/bin/env bash
set -euo pipefail
readonly QWEN_PREFLIGHT_REAL_HOME='/home/williamdev'
readonly QWEN_PREFLIGHT_SECRET_FILE='/home/williamdev/.qwen/.env'
readonly QWEN_PREFLIGHT_BIN='/home/williamdev/.local/bin/qwen'
readonly QWEN_PREFLIGHT_EXPECTED_UID='1006'
readonly QWEN_PREFLIGHT_EXPECTED_GID='1006'
readonly QWEN_PREFLIGHT_EXPECTED_MODE='775'
readonly QWEN_PREFLIGHT_EXPECTED_SHA256='f8c2e688c63adaac6e2f5792be6481a3520d1337644b9475332250ac8954689e'
real_home=$QWEN_PREFLIGHT_REAL_HOME
trusted=$QWEN_PREFLIGHT_BIN
secret_file=$QWEN_PREFLIGHT_SECRET_FILE
[[ "$trusted" == /* && "$secret_file" == /* ]] || exit 77
[[ -x "$trusted" && -f "$trusted" && ! -L "$trusted" ]] || { printf '%s\n' 'qwen_cli=missing_or_unsafe' 'runtime_ready=false' 'secret_values_recorded=false' >&2; exit 77; }
[[ "$(/usr/bin/readlink -f "$trusted")" == "$trusted" ]] || { printf '%s\n' 'qwen_cli=untrusted_path' 'runtime_ready=false' 'secret_values_recorded=false' >&2; exit 77; }
trusted_metadata=$(/usr/bin/stat -c '%F|%a|%u|%g|%h' "$trusted")
[[ "$trusted_metadata" == "regular file|${QWEN_PREFLIGHT_EXPECTED_MODE}|${QWEN_PREFLIGHT_EXPECTED_UID}|${QWEN_PREFLIGHT_EXPECTED_GID}|1" ]] || { printf '%s\n' 'qwen_cli=wrong_identity' 'runtime_ready=false' 'secret_values_recorded=false' >&2; exit 77; }
trusted_sha256=$(/usr/bin/sha256sum "$trusted" | /usr/bin/awk '{print $1}')
[[ "$trusted_sha256" == "$QWEN_PREFLIGHT_EXPECTED_SHA256" ]] || { printf '%s\n' 'qwen_cli=hash_mismatch' 'runtime_ready=false' 'secret_values_recorded=false' >&2; exit 77; }
[[ -f "$secret_file" && "$(/usr/bin/stat -c '%a' "$secret_file")" == 600 ]] || { printf '%s\n' 'auth_reference=missing_or_unsafe' 'runtime_ready=false' 'secret_values_recorded=false' >&2; exit 77; }
owner_group=$(/usr/bin/stat -c '%u:%g:%h' "$secret_file"); [[ "$owner_group" == "${QWEN_PREFLIGHT_EXPECTED_UID}:${QWEN_PREFLIGHT_EXPECTED_GID}:1" ]] || { printf '%s\n' 'auth_reference=wrong_owner_or_group' 'runtime_ready=false' >&2; exit 77; }
resolved=$(/usr/bin/readlink -f "$secret_file"); [[ "$resolved" == "$real_home/.qwen/.env" ]] || { printf '%s\n' 'auth_reference=untrusted_path' 'runtime_ready=false' >&2; exit 77; }
ver=$($trusted --version 2>&1 || true); [[ "$ver" == *0.21.14* ]] || { printf '%s\n' 'qwen_cli=version_mismatch' 'runtime_ready=false' >&2; exit 77; }
[[ -z "${HIVECREW_QWEN_CHAIN_TRACE:-}" ]] || printf '%s\n' qwen-preflight >> "$HIVECREW_QWEN_CHAIN_TRACE"
printf 'qwen_cli=present_verified\nqwen_path=%s\nauth_reference=present_verified\nlandlock_preflight=required\nsandbox_required=true\nmax_tool_calls=0\nno_model_call=true\nsecret_values_recorded=false\n' "$trusted"
