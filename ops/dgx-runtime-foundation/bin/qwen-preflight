#!/usr/bin/env bash
set -euo pipefail
trusted=/home/williamdev/.local/bin/qwen; [[ "$trusted" == /* ]] || exit 77; if [[ -x "$trusted" ]]; then ver=$("$trusted" --version 2>&1 || true); [[ "$ver" == *0.21.14* ]] && state=present_verified || state=version_mismatch; else state=missing; fi; printf "qwen_cli=%s path=%s required_version=0.21.14\\nlandlock_preflight=required\\nno_model_call=true\\nsecret_values_recorded=false\\n" "$state" "$trusted"; [[ "$state" == present_verified ]] || exit 77
