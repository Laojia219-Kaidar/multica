#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repo=$(CDPATH= cd -- "$root/../.." && pwd)
prefix="$root/.installed"
backup="$root/.backups/qwen-fast-path-v3"
[[ -n "$(printenv HIVECREW_RUNTIME_PREFIX || true)" ]] && prefix="$(printenv HIVECREW_RUNTIME_PREFIX)"
[[ -n "$(printenv HIVECREW_BACKUP_DIR || true)" ]] && backup="$(printenv HIVECREW_BACKUP_DIR)"
mode=--preview
(( $# == 0 )) || mode="$1"
[[ "$mode" == --preview || "$mode" == --apply ]] || exit 2
sha=$("$root/bin/package-digest")
[[ "$mode" == --preview ]] && { printf 'preview package_digest=%s\n' "$sha"; exit 0; }
if [[ -e "$prefix" ]]; then
  [[ -f "$prefix/state/install.manifest" ]] || { echo conflict >&2; exit 73; }
  mkdir -p "$backup"
  cp -a "$prefix/." "$backup/"
fi
mkdir -p "$prefix/bin" "$prefix/state"
for name in runtime-wrapper qwen-chain qwen-preflight resolve-runtime; do
  cp "$root/bin/$name" "$prefix/bin/$name"
done
cp "$root/bin/qwen-hive-qwen" "$prefix/bin/qwen-hive-qwen"
cp "$root/bin/qwen-hive-qwen" "$prefix/bin/qwen-hive-qwen-landlock"
cp "$root/bin/runtime-wrapper" "$prefix/bin/hivecrew-runtime-wrapper"
cp "$root/profiles.json" "$prefix/profiles.json"
cp "$repo/scripts/security/qwen-landlock-launcher.sh" "$prefix/bin/qwen-landlock-launcher.sh"
chmod 755 "$prefix/bin/runtime-wrapper" "$prefix/bin/hivecrew-runtime-wrapper" "$prefix/bin/qwen-chain" "$prefix/bin/qwen-preflight" "$prefix/bin/resolve-runtime" "$prefix/bin/qwen-landlock-launcher.sh" "$prefix/bin/qwen-hive-qwen" "$prefix/bin/qwen-hive-qwen-landlock"
printf 'digest=%s\nbackup=%s\n' "$sha" "$backup" > "$prefix/state/install.receipt"
printf 'qwen_executor_ready=false\nagent_ready=false\ndaemon_ready=false\ncanary_authorized=false\nmodel_call_executed=false\n' > "$prefix/state/readiness.manifest"
printf 'digest=%s\n' "$sha" > "$prefix/state/install.manifest"
