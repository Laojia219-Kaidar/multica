#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); prefix=${HIVECREW_RUNTIME_PREFIX:-"$root/.installed"}; backup=${HIVECREW_BACKUP_DIR:-"$root/.backups/qwen-fast-path-v1"}; mode=${1:---preview}; [[ "$mode" == --preview || "$mode" == --apply ]] || exit 2
sha=$(sha256sum "$root/profiles.json" "$root/bin/runtime-wrapper" | sha256sum | awk "{print \$1}")
[[ "$mode" == --preview ]] && { printf "preview package_sha=%s prefix=%s\\n" "$sha" "$prefix"; exit 0; }
[[ ! -e "$prefix" ]] || { echo conflict >&2; exit 73; }; mkdir -p "$prefix/bin" "$prefix/state" "$backup"; cp "$root/bin/runtime-wrapper" "$prefix/bin/hivecrew-runtime-wrapper"; chmod 755 "$prefix/bin/hivecrew-runtime-wrapper"; printf "%s\\n" "$sha" > "$prefix/state/install.manifest"; printf "backup=%s\\nsha=%s\\n" "$backup" "$sha" > "$prefix/state/install.receipt"
