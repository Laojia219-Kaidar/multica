#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
trace_marker(){ [[ -z "${HIVECREW_QWEN_CHAIN_TRACE:-}" ]] || printf '%s\n' "$1" >> "$HIVECREW_QWEN_CHAIN_TRACE"; }
profile=${1:-}; shift || true
case "$profile" in
  qwen-hive-qwen|qwen-hive-qwen-landlock) ;;
  *) echo 'qwen-chain accepts only Qwen profiles' >&2; exit 1 ;;
esac
# Direct chain callers retain the historical fail-closed no-tool behavior.
# The daemon-owned entrypoint sets a governed bounded policy only after
# validating its exact budget/allowlist arguments. The staging development
# policy deliberately omits a tool-call budget while retaining its allowlist.
: "${HIVECREW_QWEN_TOOL_POLICY:=deny}"
export HIVECREW_QWEN_TOOL_POLICY
"$root/bin/resolve-runtime" "$profile" --dry-run >/dev/null
trace_marker resolver
export HIVECREW_QWEN_LANDLOCK_REQUIRED=1
exec "$root/bin/runtime-wrapper" "$profile" "$@"
