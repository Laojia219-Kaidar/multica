#!/usr/bin/env bash
set -Eeuo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
profile=${HIVECREW_QWEN_PROFILE_ID:-qwen-hive-qwen}
readonly bounded_read_tools='read_file,glob,grep_search,list_directory'
readonly bounded_workspace_tools='read_file,glob,grep_search,list_directory,edit,write_file'
readonly workspace_tools='read_file,glob,grep_search,list_directory,edit,write_file,run_shell_command'
model_seen=0
approval_seen=0
approval_value=''
max_tools_seen=0
max_tools_value=''
allowed_tools_seen=0
allowed_tools_value=''
sandbox_seen=0
forward=()

[[ -z "${HIVECREW_QWEN_TOOL_POLICY+x}" ]] || {
  echo governed-qwen-policy-env-override >&2
  exit 77
}

while (( $# > 0 )); do
  case "$1" in
    --model)
      [[ $# -ge 2 && "$2" == qwen3.7-plus && "$model_seen" == 0 ]] || exit 77
      model_seen=1
      shift 2
      ;;
    --model=qwen3.7-plus)
      [[ "$model_seen" == 0 ]] || exit 77
      model_seen=1
      shift
      ;;
    --approval-mode)
	  [[ $# -ge 2 && "$approval_seen" == 0 ]] || exit 77
      approval_seen=1
	  approval_value="$2"
      shift 2
      ;;
    --approval-mode=*)
      [[ "$approval_seen" == 0 ]] || exit 77
      approval_seen=1
	  approval_value="${1#*=}"
      shift
      ;;
    --max-tool-calls)
	  [[ $# -ge 2 && "$max_tools_seen" == 0 ]] || exit 77
      max_tools_seen=1
	  max_tools_value="$2"
      shift 2
      ;;
    --max-tool-calls=*)
      [[ "$max_tools_seen" == 0 ]] || exit 77
      max_tools_seen=1
	  max_tools_value="${1#*=}"
	  shift
	  ;;
	--allowed-tools)
	  [[ $# -ge 2 && "$allowed_tools_seen" == 0 ]] || exit 77
	  allowed_tools_seen=1
	  allowed_tools_value="$2"
	  shift 2
	  ;;
	--allowed-tools=*)
	  [[ "$allowed_tools_seen" == 0 ]] || exit 77
	  allowed_tools_seen=1
	  allowed_tools_value="${1#*=}"
      shift
      ;;
    --sandbox)
      [[ "$sandbox_seen" == 0 ]] || exit 77
      sandbox_seen=1
      shift
      ;;
    --model=*|--approval-mode=*|--sandbox=*|--no-sandbox|--yolo|-y|--safe-mode|--safe-mode=*|--bare|--bare=*|--core-tools|--core-tools=*|--include-tools|--include-tools=*|--exclude-tools|--exclude-tools=*)
      echo governed-qwen-flag-override >&2
      exit 77
      ;;
    *)
      forward+=("$1")
      shift
      ;;
  esac
done

[[ "$model_seen" == 1 && "$approval_seen" == 1 && "$sandbox_seen" == 1 ]] || {
  echo governed-qwen-flags-missing >&2
  exit 77
}
case "${approval_value}|${max_tools_seen}|${max_tools_value}|${allowed_tools_seen}|${allowed_tools_value}" in
  'plan|1|0|0|') HIVECREW_QWEN_TOOL_POLICY=deny ;;
  "plan|1|8|1|${bounded_read_tools}") HIVECREW_QWEN_TOOL_POLICY=bounded_read ;;
  "auto-edit|1|12|1|${bounded_workspace_tools}") HIVECREW_QWEN_TOOL_POLICY=bounded_workspace_noshell ;;
  "auto-edit|0||1|${workspace_tools}") HIVECREW_QWEN_TOOL_POLICY=bounded_workspace ;;
  *) echo governed-qwen-policy-mismatch >&2; exit 77 ;;
esac
export HIVECREW_QWEN_TOOL_POLICY
[[ -z "${HIVECREW_QWEN_CHAIN_TRACE:-}" ]] || printf '%s\n' go-entrypoint >> "$HIVECREW_QWEN_CHAIN_TRACE"
exec "$root/bin/qwen-chain" "$profile" "${forward[@]}"
