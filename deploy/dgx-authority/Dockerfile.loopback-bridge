FROM golang:1.26-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/cmd/authority-loopback-bridge ./server/cmd/authority-loopback-bridge
RUN cd server && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /bridge ./cmd/authority-loopback-bridge
FROM alpine:3.21
COPY --from=build /bridge /bridge
USER 65532:65532
ENTRYPOINT ["/bridge"]
